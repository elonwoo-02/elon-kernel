# Never cache HTML pages — ensures users always get latest deploy
/*.html
  Cache-Control: public, no-cache
  X-Robots-Tag: noindex, nofollow

/
  Cache-Control: public, no-cache

# Hash-stamped build assets — cache forever at edge
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Service Worker — short TTL so browser picks up updates fast
/sw.js
  Cache-Control: public, max-age=600
