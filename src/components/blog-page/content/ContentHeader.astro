---
import DrawerIcon from "../../shared/icons/blog/DrawerIcon.astro";
import SearchIcon from "../../shared/icons/blog/SearchIcon.astro";

const {title, count} = Astro.props;
---
<div class="flex w-full items-center justify-between">
  <button
    class="drawer-toggle-btn relative z-10 inline-flex shrink-0 items-center justify-center p-1.5 rounded-xl transition-all duration-200 group"
    aria-label="Open Sidebar"
    type="button"
  >
    <DrawerIcon/>
  </button>

  <div class="flex items-center gap-2">
    <h2 class="text-xl font-bold text-base-content/70 uppercase tracking-tight">
      {title}
    </h2>
    {
      count !== undefined && (
        <span class="text-sm font-mono text-base-content/40">{count}</span>
      )
    }
  </div>

  <div class="flex shrink-0 items-center gap-1">
    <button class="p-1.5 hover:bg-base-200 hover:text-gray-600 rounded-lg transition-colors">
      <slot name="header-right" />
    </button>
    <button class="p-1.5 hover:bg-base-200 hover:text-gray-600 rounded-lg transition-colors">
      <SearchIcon/>
    </button>
  </div>
</div>
