---
interface HeadingItem {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: HeadingItem[];
  title?: string;
}

const { headings, title = "目录" } = Astro.props as Props;
---

<nav class="post-toc" aria-label="文章目录">
  <h2 class="post-toc-title">{title}</h2>

  {
    headings.length > 0 ? (
      <ul class="post-toc-list">
        {headings.map((heading) => (
          <li>
            <a
              href={`#${heading.slug}`}
              data-post-toc-link
              data-target-id={heading.slug}
              class:list={[
                "post-toc-link",
                heading.depth >= 3 ? "post-toc-link--nested" : "",
              ]}
            >
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="text-sm text-slate-500">暂无可导航章节。</p>
    )
  }
</nav>

<style>
  .post-toc {
    padding: 0;
  }

  .post-toc-title {
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--app-text-muted);
    margin-bottom: 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid color-mix(in srgb, var(--app-border) 60%, transparent);
  }

  .post-toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .post-toc-link {
    display: flex;
    font-size: 0.8125rem;
    line-height: 1.5;
    padding: 0.35rem 0.75rem;
    border-radius: 0.375rem;
    color: var(--app-text-muted);
    text-decoration: none;
    transition: all 150ms ease;
    border-left: 2px solid transparent;
  }

  .post-toc-link--nested {
    padding-left: 1.75rem;
  }

  .post-toc-link:hover {
    color: var(--app-text);
    background: color-mix(in srgb, var(--app-accent) 8%, transparent);
    border-left-color: color-mix(in srgb, var(--app-accent) 30%, transparent);
  }

  .post-toc-link--active {
    color: var(--app-accent) !important;
    background: color-mix(in srgb, var(--app-accent) 10%, transparent) !important;
    border-left-color: var(--app-accent) !important;
    font-weight: 600;
  }

  .post-toc-link--inactive {
    color: var(--app-text-muted);
    font-weight: 400;
  }
</style>
