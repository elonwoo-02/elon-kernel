---
import BaseLayout from "./BaseLayout.astro";
import PostShell from "../components/blog-page/post/PostShell.astro";
import PostHeader from "../components/blog-page/post/PostHeader.astro";
import PostContent from "../components/blog-page/post/PostContent.astro";
import PostProgressIsland from "../components/blog-page/post/PostProgressIsland";
import PostMobileHeader from "../components/blog-page/post/PostMobileHeader.astro";

const {
  frontmatter,
  headings = [],
  readingTime = 1,
} = Astro.props as {
  frontmatter: {
    title: string;
    pubDate: Date;
    description: string;
    author: string;
    image?: {
      url: string;
      alt: string;
    };
    tags?: string[];
  };
  headings?: { depth: number; slug: string; text: string }[];
  readingTime?: number;
};
---

<BaseLayout pageTitle={frontmatter.title} mainClass="pt-0 md:pt-8" contentClass="px-0 sm:px-4 lg:px-8" showElonFloat={false}>
  <div class="post-progress" aria-hidden="true">
    <span id="reading-progress"></span>
  </div>

  <PostMobileHeader />

  <PostShell>
    <div slot="main">
      <PostHeader frontmatter={frontmatter} readingTime={readingTime} />
      <PostContent>
        <slot />
      </PostContent>
    </div>
  </PostShell>

  <PostProgressIsland client:load />
</BaseLayout>

<style>
  .post-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 90;
    height: 3px;
  }

  #reading-progress {
    display: block;
    height: 100%;
    width: 0%;
    background: linear-gradient(
      90deg,
      var(--app-accent-hover),
      var(--app-accent)
    );
    transition: width 0.1s linear;
  }
</style>
